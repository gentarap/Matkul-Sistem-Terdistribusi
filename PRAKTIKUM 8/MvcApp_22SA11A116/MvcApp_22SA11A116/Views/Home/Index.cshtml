
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Data Pegawai</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome (untuk ikon edit & hapus) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Site.css (jika ada) -->
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Scripts/modernizr-2.5.3.js")" type="text/javascript"></script>
</head>

<body class="bg-light">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3"><a href="/" class="text-decoration-none">STMIK AMIKOM Purwokerto</a></h1>
        </div>

        <!-- Form Cari Pegawai -->
        <div class="card mb-4">
            <div class="card-body">
                <form class="row g-3">
                    <div class="col-md-6">
                        <label for="pegawaiId" class="form-label">NIP</label>
                        @Html.TextBox("pegawaiId", null, new { @class = "form-control", @id = "pegawaiId" })
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary" onclick="GetPegawaiByIdJSON()">Data Pegawai Berdasarkan NIP</button>
                        <button type="button" class="btn btn-secondary" onclick="GetPegawaiJSON()">Semua Data Pegawai</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabel Pegawai -->
        <div id="employees" class="mb-4"></div>

        <!-- Form Edit Pegawai -->
        <div id="employeesEdit" class="card p-4">
            <h5>Edit Data Pegawai</h5>
            <form class="row g-3">
                <div class="col-md-6">
                    <label for="txtNip" class="form-label">NIP</label>
                    @Html.TextBox("txtNip", null, new { @class = "form-control", @id = "txtNip" })
                </div>
                <div class="col-md-6">
                    <label for="txtNama" class="form-label">Nama</label>
                    @Html.TextBox("txtNama", null, new { @class = "form-control", @id = "txtNama" })
                </div>
                <div class="col-md-6">
                    <label for="txtJenisKelamin" class="form-label">Jenis Kelamin</label>
                    @Html.TextBox("txtJenisKelamin", null, new { @class = "form-control", @id = "txtJenisKelamin" })
                </div>
                <div class="col-12">
                    <label for="txtAlamat" class="form-label">Alamat</label>
                    @Html.TextArea("txtAlamat", new { @class = "form-control", @id = "txtAlamat", rows = "3" })
                </div>
                <div class="col-md-6">
                    <label for="txtKodeJabatan" class="form-label">Kode Jabatan</label>
                    @Html.TextBox("txtKodeJabatan", null, new { @class = "form-control", @id = "txtKodeJabatan" })
                </div>
                <div class="col-12">
                    <label id="errMsg" class="text-danger"></label>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" onclick="AddPegawai()">Tambah Pegawai</button>
                    <button type="button" class="btn btn-warning" onclick="UpdatePegawai()">Update Pegawai</button>
                    <button type="button" class="btn btn-danger" onclick="DeletePegawai()">Hapus Pegawai</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        function ResetForm() {
            $("#txtNip").val("");
            $("#txtNama").val("");
            $("#txtJenisKelamin").val("");
            $("#txtAlamat").val("");
            $("#txtKodeJabatan").val("");
            $("#errMsg").html("").hide();
        }

        function GetPegawaiJSON() {
            $.getJSON("/amikom/pegawai", function (data) {
                if (!data || data.length === 0) {
                    $('#employees').html('<div class="alert alert-warning">Tidak ada data pegawai.</div>');
                    return;
                }

                let strHTML = `
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>NIP</th>
                                        <th>Nama</th>
                                        <th>Jenis Kelamin</th>
                                        <th>Alamat</th>
                                        <th>Kode Jabatan</th>
                                        <th>Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>`;

                $.each(data, function (key, val) {
                    strHTML += `
                            <tr>
                                <td>${val.nip}</td>
                                <td>${val.nama}</td>
                                <td>${val.jenis_kelamin}</td>
                                <td>${val.alamat}</td>
                                <td>${val.kode_jabatan}</td>
                                <td>
                                    <button class="btn btn-sm btn-warning me-1" onclick="LoadPegawai('${val.nip}')"><i class="fas fa-edit"></i> Edit</button>
                                    <button class="btn btn-sm btn-danger" onclick="DeletePegawaiById('${val.nip}')"><i class="fas fa-trash"></i> Hapus</button>
                                </td>
                            </tr>`;
                });

                strHTML += `</tbody></table></div>`;
                $('#employees').html(strHTML);
            }).fail(function (jqXHR, textStatus, error) {
                $('#employees').html(`<div class="alert alert-danger">Error: ${error}</div>`);
            });
        }

        function GetPegawaiByIdJSON() {
            const nip = $("#pegawaiId").val().trim();
            if (!nip) {
                alert("Silakan masukkan NIP pegawai");
                return;
            }

            $.getJSON(`/amikom/pegawai/${nip}`, function (data) {
                if (data) {
                    $("#txtNip").val(data.nip);
                    $("#txtNama").val(data.nama);
                    $("#txtJenisKelamin").val(data.jenis_kelamin);
                    $("#txtAlamat").val(data.alamat);
                    $("#txtKodeJabatan").val(data.kode_jabatan);
                    $('#errMsg').html('').hide();
                } else {
                    alert("Data pegawai tidak ditemukan");
                    ResetForm();
                }
            }).fail(function (jqXHR, textStatus, err) {
                $('#errMsg').html('Error: ' + err).show();
            });
        }

        function LoadPegawai(id) {
            $.getJSON(`/amikom/pegawai/${id}`, function (data) {
                if (data) {
                    $("#txtNip").val(data.nip);
                    $("#txtNama").val(data.nama);
                    $("#txtJenisKelamin").val(data.jenis_kelamin);
                    $("#txtAlamat").val(data.alamat);
                    $("#txtKodeJabatan").val(data.kode_jabatan);
                    $('#errMsg').html('').hide();
                    $('html, body').animate({ scrollTop: $("#employeesEdit").offset().top - 20 }, 500);
                }
            }).fail(function (jqXHR, textStatus, err) {
                $('#errMsg').html('Error: ' + err).show();
            });
        }

        function AddPegawai() {
            const nip = $("#txtNip").val().trim();
            const nama = $("#txtNama").val().trim();

            if (!nip || !nama) {
                $('#errMsg').html('NIP dan Nama harus diisi.').show();
                return;
            }

            const pegawai = {
                nip: nip,
                nama: nama,
                jenis_kelamin: $("#txtJenisKelamin").val().trim(),
                alamat: $("#txtAlamat").val().trim(),
                kode_jabatan: $("#txtKodeJabatan").val().trim()
            };

            $.ajax({
                url: "/amikom/pegawai",
                type: "POST",
                data: JSON.stringify(pegawai),
                contentType: "application/json",
                success: function () {
                    alert("Data pegawai berhasil ditambahkan");
                    ResetForm();
                    GetPegawaiJSON();
                },
                error: function (xhr) {
                    $('#errMsg').html('Error: ' + xhr.responseText).show();
                }
            });
        }

        function UpdatePegawai() {
            const nip = $("#txtNip").val().trim();
            if (!nip) {
                $('#errMsg').html('Silakan cari atau pilih pegawai terlebih dahulu.').show();
                return;
            }

            const pegawai = {
                nip: nip,
                nama: $("#txtNama").val().trim(),
                jenis_kelamin: $("#txtJenisKelamin").val().trim(),
                alamat: $("#txtAlamat").val().trim(),
                kode_jabatan: $("#txtKodeJabatan").val().trim()
            };

            $.ajax({
                url: "/amikom/pegawai",
                type: "PUT",
                data: JSON.stringify(pegawai),
                contentType: "application/json",
                success: function () {
                    alert("Data pegawai berhasil diupdate");
                    ResetForm();
                    GetPegawaiJSON();
                },
                error: function (xhr) {
                    $('#errMsg').html('Error: ' + xhr.responseText).show();
                }
            });
        }

        function DeletePegawai() {
            const id = $("#txtNip").val().trim();
            if (!id) {
                $('#errMsg').html('Silakan cari pegawai terlebih dahulu.').show();
                return;
            }
            DeletePegawaiById(id);
        }

        function DeletePegawaiById(id) {
            if (confirm(`Apakah anda yakin ingin menghapus data pegawai dengan NIP ${id}?`)) {
                $.ajax({
                    url: `/amikom/pegawai/${id}`,
                    type: "DELETE",
                    success: function () {
                        alert("Data pegawai berhasil dihapus");
                        ResetForm();
                        GetPegawaiJSON();
                    },
                    error: function (xhr) {
                        $('#errMsg').html('Error: ' + xhr.responseText).show();
                    }
                });
            }
        }

        $(document).ready(function () {
            ResetForm();
            GetPegawaiJSON();
        });
    </script>
</body>
</html>
