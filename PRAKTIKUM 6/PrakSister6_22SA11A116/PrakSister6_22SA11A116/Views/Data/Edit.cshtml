@model DataModel

@{
    ViewBag.Title = "Edit Data";
}

<h2>Edit Data</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.IdBuku) <!-- Untuk menyimpan ID data yang sedang diedit -->

    <div class="form-group">
        @Html.LabelFor(m => m.JudulBuku)
        @Html.TextBoxFor(m => m.JudulBuku, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Deskripsi)
        @Html.TextBoxFor(m => m.Deskripsi, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Batal</a>
}
