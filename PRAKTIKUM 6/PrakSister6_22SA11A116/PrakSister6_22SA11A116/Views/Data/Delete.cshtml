@model DataModel

@{
    ViewBag.Title = "Hapus Data";
}

<h2>Delete Data</h2>

<div>
    <h4>Apakah Anda Yakin Akan Menghapus Data Ini?</h4>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.JudulBuku)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.JudulBuku)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Deskripsi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Deskripsi)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        <button type="submit" class="btn btn-danger">Hapus</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Batal</a>
    }
</div>
