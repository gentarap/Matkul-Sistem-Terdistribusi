@model IEnumerable<DataModel>

@{
    ViewBag.Title = "Data List";
}

<h2>Data List</h2>

<a href="@Url.Action("Create")" class="btn btn-primary">Tambah Data Baru</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID Buku</th>
            <th>Judul Buku</th>
            <th>Deskripsi</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdBuku</td>
                <td>@item.JudulBuku</td>
                <td>@item.Deskripsi</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.IdBuku })" class="btn btn-warning">Edit</a>
                    <a href="@Url.Action("Delete", new { id = item.IdBuku })" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>